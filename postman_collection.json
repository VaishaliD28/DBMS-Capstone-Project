              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"opportunityId\": 2,\n  \"coverLetter\": \"Excited to apply for Google Cloud Intern.\",\n  \"resumeUrl\": \"/uploads/sample-resume.pdf\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/applications/apply", "host": ["{{baseUrl}}"], "path": ["applications", "apply"] }
