            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aarav Sharma\",\n  \"phone\": \"+91 9100010001\",\n  \"department\": \"Computer Science and Engineering\",\n  \"cgpa\": 9.50,\n  \"graduationYear\": 2025,\n  \"bio\": \"Updated bio: Cloud engineer & Full stack developer.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/students/profile", "host": ["{{baseUrl}}"], "path": ["students", "profile"] }
          }
        },
        {
          "name": "Get Student Skills",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/students/skills", "host": ["{{baseUrl}}"], "path": ["students", "skills"] }
          }
        },
        {
          "name": "Check Eligibility & Smart Skill Match",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/students/eligibility/1", "host": ["{{baseUrl}}"], "path": ["students", "eligibility", "1"] }
          }
        }
      ]
    },
    {
      "name": "3. Opportunities (Jobs & Internships)",
      "item": [
        {
          "name": "Browse Opportunities (Filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/opportunities?status=approved&type=job", "host": ["{{baseUrl}}"], "path": ["opportunities"], "query": [{ "key": "status", "value": "approved" }, { "key": "type", "value": "job" }] }
          }
        },
        {
          "name": "Get Single Opportunity Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/opportunities/1", "host": ["{{baseUrl}}"], "path": ["opportunities", "1"] }
          }
        },
        {
          "name": "Create New Opportunity (Recruiter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{recruiterToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Software Engineer\",\n  \"type\": \"job\",\n  \"category\": \"Software Development\",\n  \"description\": \"Build scalable distributed systems and RESTful APIs.\",\n  \"requirements\": \"Proficiency in Node.js, Express, MySQL, Docker.\",\n  \"location\": \"Bangalore, Karnataka\",\n  \"workMode\": \"Hybrid\",\n  \"minCgpa\": 8.0,\n  \"allowedGraduationYear\": 2025,\n  \"salaryOrStipend\": \"₹ 22,00,000 - ₹ 26,00,000 PA\",\n  \"openingsCount\": 4,\n  \"deadline\": \"2026-12-31\",\n  \"skillIds\": [1, 7, 8, 12]\n}"
            },
            "url": { "raw": "{{baseUrl}}/opportunities", "host": ["{{baseUrl}}"], "path": ["opportunities"] }
          }
        }
      ]
    },
    {
      "name": "4. Applications Workflow",
      "item": [
