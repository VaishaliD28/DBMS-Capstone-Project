            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Interview\",\n  \"remarks\": \"Selected for Round 2 Technical System Design Interview.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/applications/1/status", "host": ["{{baseUrl}}"], "path": ["applications", "1", "status"] }
          }
        }
      ]
